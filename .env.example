# Copy this file to .env for local development only.
# On Render, set these as real Environment Variables in the dashboard instead —
# never commit an actual .env file to GitHub.

DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require
ADMIN_PASSWORD=OutdoorCraftCo2026
PORT=3000

# Stripe (test mode keys start with sk_test_ — switch to sk_live_ when ready
# to accept real payments). Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional but recommended once deployed — see README "Stripe webhook" section.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Needed so payment success/cancel links point back to the right place.
# Locally: http://localhost:3000 — on Render this is auto-detected, no need to set it.
PUBLIC_BASE_URL=http://localhost:3000
